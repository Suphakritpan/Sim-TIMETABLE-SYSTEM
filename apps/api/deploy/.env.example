# Copy to deploy/.env on the server. It is never committed.
# The API's domain name; its DNS record must point at this server.
API_DOMAIN=api.example.com
# The website's real origins, separated by commas. Never *.
ALLOWED_ORIGINS=https://example.vercel.app
# A long random value, for example from: openssl rand -hex 32
POSTGRES_PASSWORD=
