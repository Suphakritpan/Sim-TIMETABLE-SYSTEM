# Copy to .env and change for your machine. .env is never committed.
APP_ENV=dev
# Two projects at once: give each its own DB_PORT, and use the same port in DATABASE_URL.
DB_PORT=5434
DATABASE_URL=postgresql+psycopg://app:app@localhost:5434/app
# Outside dev this is required: the real site origins, separated by commas. Never *.
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
